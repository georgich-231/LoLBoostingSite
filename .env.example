NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local SQLite database for development.
DATABASE_URL="file:./prisma/dev.db"

# Seeded admin account for local/admin setup.
ADMIN_SEED_EMAIL="admin@riftprogress.gg"
ADMIN_SEED_PASSWORD="RiftAdmin!2026"
# Set to "true" only when you explicitly want sample users/orders/revenue locally.
SEED_DEMO_DATA="false"

# Riot Sign On / OAuth. Keep secrets server-side only.
RIOT_CLIENT_ID=""
RIOT_CLIENT_SECRET=""
RIOT_REDIRECT_URI="http://localhost:3000/api/riot/link/callback"
RIOT_API_KEY=""
RIOT_DEFAULT_PLATFORM="EUW1"

# Google and Discord account login. Keep secrets server-side only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Stripe. Use test keys locally.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Redis for Riot API cache, refresh jobs, rate limiting, and notifications.
REDIS_URL="redis://localhost:6379"

# Storage for VOD reviews, profile images, and attachments.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Session and encryption secrets.
SESSION_SECRET="replace-with-32-plus-random-bytes"
OAUTH_TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
